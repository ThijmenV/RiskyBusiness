  "description": "A multi-user online version of Risky Business with accounts, groups, and shared gameplay.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "migrate:legacy": "node scripts/migrate-legacy.js",
