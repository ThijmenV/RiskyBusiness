# Local development: no credentials required. Node does not automatically load this file.
# Optional: node --env-file=.env server.js
NODE_ENV=development
PORT=3000
DB_PATH=./data/app.json
# Production: DATABASE_URL and a SESSION_SECRET of at least 32 random characters are required.
# Use the provider's connection string with TLS certificate verification enabled.
# DATABASE_URL=postgresql://...
# SESSION_SECRET=...
# Hosted runtime: run npm run db:migrate (or import:postgres) before deployment.
# Runtime verifies schema; it does not create/alter database tables in production.
# Netlify automatically selects production mode outside local dev.
